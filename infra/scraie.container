# Nightly flight price scrape. Podman Quadlet, run to completion (oneshot).
# Install to /etc/containers/systemd/ -- daemon-reload generates scraie.service.
# Triggered by scraie.timer. Secrets: /etc/scraie/scraie.env (root:root 0600).
#
#   sudo /usr/libexec/podman/quadlet -dryrun   # preview generated unit, catch bad keys
#   journalctl -u scraie.service -e            # logs
[Unit]
Description=Scraie flight price scraping job

[Container]
ContainerName=scraie
Image=docker.io/maxmwang/scraie:latest
Pull=newer
EnvironmentFile=/etc/scraie/scraie.env
Environment=LOG_JSON=true

[Service]
Type=oneshot
TimeoutStartSec=900
# network-online.target does not re-arm across suspend/resume, so poll for real
# DNS instead: this unit can start at the instant of wake, before DHCP settles.
ExecStartPre=/bin/sh -c 'until getent hosts www.google.com >/dev/null 2>&1; do sleep 5; done'
# Return to S3 once the scrape finishes. Note this also fires when the run
# fails; mask or comment out while debugging.
ExecStopPost=/usr/bin/systemctl suspend
